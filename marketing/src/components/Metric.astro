---
interface Props { value: string; label: string }
const { value, label } = Astro.props;
---
<div class="border border-amber/15 rounded-sm bg-layer/30 p-5 shadow-card mb-5">
  <div class="font-sans text-3xl text-amber mb-1">{value}</div>
  <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-muted/70">{label}</div>
</div>
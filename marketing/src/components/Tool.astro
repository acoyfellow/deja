---
interface Props { name: string; body: string }
const { name, body } = Astro.props;
---
<div class="border border-amber/10 rounded-sm bg-layer/20 px-4 py-4">
  <code class="font-mono text-[12px] text-amber">{name}</code>
  <p class="font-sans font-light text-[13px] text-muted/85 leading-relaxed mt-2">{body}</p>
</div>